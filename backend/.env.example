APP_NAME="FormaMind AI API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./formamind.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=development-only-change-me-formamind-auth-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIRECTORY=uploads/documents
