APP_NAME="FormaMind AI API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./formamind.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET_KEY=development-only-change-me-formamind-auth-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIRECTORY=uploads/documents

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CHROMA_PERSIST_DIRECTORY=vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.24

ASSESSMENT_MAX_QUESTIONS=20
ASSESSMENT_CONTEXT_TOP_K=12
ASSESSMENT_AGENT_TEMPERATURE=0.2

LEARNING_PLAN_MAX_MODULES=6
LEARNING_PLAN_MAX_ACTIVITIES_PER_MODULE=5
LEARNING_CONTENT_TOP_K=10
LEARNING_COACH_TEMPERATURE=0.2
DEFAULT_DAILY_STUDY_MINUTES=45

SOUTENANCE_MAX_QUESTIONS=20
SOUTENANCE_AGENT_TEMPERATURE=0.25
